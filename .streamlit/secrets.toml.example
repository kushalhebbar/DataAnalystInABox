# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Cloud
# "Secrets" box when deploying. All keys are optional.

# Zero-secret demo: profiling, target detection, EDA and charts run fully;
# clarification questions and the narrative fall back to heuristics.
LLM_PROVIDER = "none"

# For full LLM features on a hosted deploy, use a provider instead:
# LLM_PROVIDER = "openai"
# LLM_MODEL = "gpt-4o-mini"
# OPENAI_API_KEY = "sk-..."

# LLM_PROVIDER = "anthropic"
# LLM_MODEL = "claude-3-5-sonnet-latest"
# ANTHROPIC_API_KEY = "sk-ant-..."

# Auto-populate the form with a bundled sample dataset on load:
# TEST_CONFIG = "code/tests/test_config.json"
